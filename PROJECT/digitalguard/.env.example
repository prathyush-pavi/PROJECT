# ============================================================
# DigitalGuard — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Django Core
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/digitalguard

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Local AI Engine
LOCAL_AI_ENDPOINT=http://127.0.0.1:8765

# Native messaging / Desktop agent
NATIVE_HOST_NAME=com.digitalguard.agent

# WebAuthn / FIDO2 (optional)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DigitalGuard
WEBAUTHN_ORIGIN=http://localhost:8000

# Logging
LOG_LEVEL=DEBUG

# Email (optional — for parent alert notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Redis (optional — for Django Channels WebSocket support)
# REDIS_URL=redis://localhost:6379/0
